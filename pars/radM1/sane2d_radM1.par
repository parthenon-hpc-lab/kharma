# SANE ("Standard and Normal Evolution" i.e. not Magnetically Arrested).
# Similar to "v5" library parameters w/adiabatic index 5/3,
# and a larger disk (rin=10/rmax=20)


<parthenon/job>
problem_id = torus
archive_parameters = timestamp

<parthenon/mesh>
nx1 = 128
nx2 = 128
nx3 = 1

<parthenon/meshblock>
nx1 = 128
nx2 = 128
nx3 = 1

<coordinates>
base = spherical_ks
transform = mks
r_out = 50
a = 0.9375
hslope = 0.3
correct_connections = true

<parthenon/time>
tlim = 60000.0
nlim = -1

<torus>
rin = 6.0
rmax = 12.0
# Tilt in degrees. YMMV.
tilt = 0.

<perturbation>
u_jitter = 0.04

<b_field>
solver = face_ct
type = sane
beta_min = 100.

<GRMHD>
cfl = 0.7
gamma = 1.666667

<flux>
type = llf
# WENO5 Adaptive Order "At Home" --
# WENO5Z with fallback to linear recon in difficult regions
reconstruction = weno5

<driver>
type = imex
# Second sync at the end of each step
# Can skip this with the robust inverter & face_ct B fields
two_sync = false

<boundaries>
inner_x2 = reflecting
outer_x2 = reflecting

<floors>
# Minimal floors, applied in the default Normal Observer frame
rho_min_geom = 1e-6
u_min_geom   = 1e-8
gamma_max    = 32

<fofc>
# FOFC is disabled by default because of tests but recommended
# for most production runs
on = false

<radM1>
on = true
u_rad_floor = 1.e-8
#Root-finding parameters for the 4D solver; Maybe transfer this to IMEX package?
src_rootfind_eps = 1e-8
src_rootfind_tol = 1e-8
src_rootfind_maxiter = 50

<units> 
on = true
M_BH = 10
rho_scale = 1e-6

<debug>
verbose = 1
extra_checks = 2
flag_verbose = 0

<parthenon/output0>
file_type = hdf5
dt = 0.5
single_precision_output = true
variables = prims, divB, jcon, fflag, pflag, rimplflag, rinvflag, fofcflag

<parthenon/output1>
file_type = rst
dt = 100.0

<parthenon/output2>
file_type = hst
dt = 0.1
