# McKinney et al. 2014 (MNRAS 441, 3177), section 5.10:
# Radiative spherical (Bondi) accretion in 1D, a/M = 0.
# Model E10T7 from Table 4: Mdot*c^2/L_Edd = 1.0, T_out = 1e6 K, fp = 1.2e-4

<parthenon/job>
problem_id = bondi_rad

<parthenon/mesh>
nx1 = 512
nx2 = 16
nx3 = 1

<parthenon/meshblock>
nx1 = 512
nx2 = 16
nx3 = 1

<coordinates>
correct_connections = false
base = spherical_ks
transform = eks
a = 0.0
r_in = 1.9
r_out = 2.e4

<parthenon/time>
tlim = 2.e4

<driver>
type = imex
two_sync = false

<GRMHD>
cfl = 0.5
gamma = 1.60215053763440
reconstruction = weno5

<eos>
type = IdealGas
gamma = 1.60215053763440
Cv = 1.0

<bondi_rad>
mdot = 10.0
T_out = 1.e7
fp = 1.2e-1
r_in_bondi = 1.9

<b_field>
solver = face_ct
type = bz_monopole
beta_min = 1.48e-3

<boundaries>
inner_x1 = outflow
# outer_x1 is set at runtime by InitializeRadiativeBondi
check_inflow_outer_x1 = false

<floors>
disable_floors = true

<inverter>
backstop = true
fix_average_neighbors = true

<radM1>
on = true
mu = 1.0
src_rootfind_eps = 1e-8 
src_rootfind_tol = 1e-8
src_rootfind_maxiter = 100

<units>
scale_free = false
geom_mass_msun = 3.0
fluid_mass_g =  6.203843e12

<parthenon/output0>
file_type = hdf5
dt = 1.0
single_precision_output = true
variables = prims, cons, rimplflag, rinvflag, pflag

<parthenon/output1>
file_type = rst
dt = 100.0

<parthenon/output2>
file_type = hst
dt = 0.1

<debug>
verbose = 1
extra_checks = 1
flag_verbose = 2
