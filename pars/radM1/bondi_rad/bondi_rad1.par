# McKinney et al. 2014 (MNRAS 441, 3177), section 5.10:
# Radiative spherical (Bondi) accretion in 1D, a/M = 0.
# Model E1T6 from Table 4: Mdot*c^2/L_Edd = 1.0, T_out = 1e6 K, fp = 1.2e-4

<parthenon/job>
problem_id = bondi_rad

<parthenon/mesh>
nx1 = 512
nx2 = 1
nx3 = 1

<parthenon/meshblock>
nx1 = 512
nx2 = 1
nx3 = 1

<coordinates>
base = spherical_ks
transform = eks
a = 0.0
r_in = 2.5
r_out = 2.e4

<parthenon/time>
tlim = 3.13e4

<driver>
type = imex
two_sync = false

<GRMHD>
cfl = 0.5
# Gamma is *derived* from fp via eq. 95 of McKinney et al. 2014, not free:
#   Gamma = 1 + (1/3)*(2+2fp)/(1+2fp)
# For fp = 1.2e-4 (model E1T6): Gamma = 1.6665866859
# Must be recomputed by hand and kept in sync here (and in <eos> below) whenever
# fp changes -- SetBondiRadImpl derives it internally for the IC itself, but eos/
# reconstruction still read it from these two keys independently.
gamma = 1.6665867
reconstruction = weno5

<eos>
type = IdealGas
Gamma = 1.6665867
Cv = 1.0

<bondi_rad>
mdot = 1.0
T_out = 1.e6
fp = 1.2e-4

<b_field>
solver = none

<boundaries>
inner_x1 = outflow
# outer_x1 is set at runtime by InitializeRadiativeBondi (SetBondiRad)
check_inflow_outer_x1 = false

<floors>
disable_floors = true

<radM1>
on = true
src_rootfind_eps = 1e-8
src_rootfind_tol = 1e-8
src_rootfind_maxiter = 50

<units>
# Required for the CGS opacity conversion (eqs. 91-92) to do anything -- with
# scale_free = true (the default) every phoebus::UnitConversions factor is 1.0.
scale_free = false
geom_mass_msun = 3.0
# Derived for model E1T6 (Mdot*c^2/L_Edd = 1.0, mdot_code = 1.0, M = 3 Msun):
#   L_Edd = 4*pi*G*M*mp*c/sigma_T           ~= 3.773e38 erg/s
#   Mdot_phys = (Mdot*c^2/L_Edd) * L_Edd/c^2 ~= 4.198e17 g/s
#   L_unit = G*M/c^2                        ~= 4.4315e5 cm
#   T_unit = L_unit/c                       ~= 1.4782e-5 s
#   fluid_mass_g = Mdot_phys * T_unit / mdot_code
fluid_mass_g = 6.206e12

<parthenon/output0>
file_type = hdf5
dt = 100.0
single_precision_output = true
variables = prims

<parthenon/output1>
file_type = hst
dt = 10.0

<debug>
verbose = 1
extra_checks = 1
flag_verbose = 2
