# Parameter file for the radiation shock tube Test 3 presented in the PLUTO paper
# https://iopscience.iop.org/article/10.3847/1538-4365/ab18ff
# To run it, I have to disable Kastaun's bad_vel_tolerance, putting it to a much higher value

# In the current version, remember to change sigma = 3.858e-8, kappa/rho = 0.3
<parthenon/job>
problem_id = shock

<parthenon/mesh>
nx1 = 800
x1min = -20.0
x1max = 20.0

nx2 = 1
x2min = 0.0
x2max = 1.0

nx3 = 1
x3min = 0.0
x3max = 1.0

<parthenon/meshblock>
nx1 = 400
nx2 = 1
nx3 = 1

<coordinates>
base = cartesian_minkowski
transform = null
correct_connections = true

<parthenon/time>
tlim = 500.0
integrator = rk2
dt_min = 0.0001

<driver>
type = imex
# Second sync at the end of each step
# Can skip this with the robust inverter & face_ct B fields
two_sync = false

<GRMHD>
cfl = 0.25
gamma = 2.
reconstruction = weno5

<b_field>
solver = none

<boundaries>
inner_x1 = outflow
outer_x1 = outflow
allow_inflow_inner_x1 = true
allow_inflow_outer_x1 = true

<shock>
rhoL = 1.
PL = 60.
u1L = 10.0
EL = 2.0

rhoR = 8.0
PR = 2.34e3
u1R = 1.25
ER = 1.14e3

rad_comoving_ic = true
rad_seed_frac = 0.01

<floors>
disable_floors = true

<parthenon/output0>
file_type = hdf5
dt = 5.0
single_precision_output = true
variables = prims

<parthenon/output1>
file_type = hst
dt = 0.1

<debug>
verbose = 1
extra_checks = 2
flag_verbose = 2

<radM1>
on = true
src_rootfind_eps = 1e-8
src_rootfind_tol = 1e-8
src_rootfind_maxiter = 50

<units> 
on = true
M_BH = 100
rho_scale = 1e-4


