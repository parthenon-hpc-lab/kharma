# shock_tube test

<parthenon/job>
problem_id = shock

<parthenon/mesh>
nx1 = 800
x1min = -10.0
x1max = 10.0

nx2 = 1
x2min = 0.0
x2max = 1.0

nx3 = 1
x3min = 0.0
x3max = 1.0

<parthenon/meshblock>
nx1 = 400
nx2 = 1
nx3 = 1

<coordinates>
base = cartesian_minkowski
transform = null
correct_connections = true

<parthenon/time>
tlim = 300.0
integrator = rk2
dt_min = 0.0001

<driver>
type = imex
# Second sync at the end of each step
# Can skip this with the robust inverter & face_ct B fields
two_sync = false

<GRMHD>
cfl = 0.5
gamma = 1.666667
reconstruction = weno5

<b_field>
solver = none

<boundaries>
inner_x1 = outflow
outer_x1 = outflow
allow_inflow_inner_x1 = true
allow_inflow_outer_x1 = true

<shock>
rhoL = 1.
PL = 3e-5
u1L = 0.015
EL = 1e-8

rhoR = 2.4
PR = 1.61e-4
u1R = 6.25e-3
ER = 2.51e-7

<floors>
disable_floors = true

<parthenon/output0>
file_type = hdf5
dt = 5.0
single_precision_output = true
variables = prims

<parthenon/output1>
file_type = hst
dt = 0.1

<debug>
verbose = 1
extra_checks = 2
flag_verbose = 2

<radM1>
on = true
sigma_rad = 3.085e9
kappa_rho = 0.4
src_rootfind_eps = 1e-8
src_rootfind_tol = 1e-8
src_rootfind_maxiter = 50

<units> 
on = true
M_BH = 100
rho_scale = 1e-4


