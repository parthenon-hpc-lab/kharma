# Hubble Flow problem, testing electron heating

<parthenon/job>
problem_id = hubble

<parthenon/mesh>
nx1 = 128
x1min = 0.0
x1max = 1.0

nx2 = 1
x2min = -0.01
x2max = 0.01

nx3 = 1
x3min = -0.01
x3max = 0.01

<parthenon/meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<boundaries>
# Hold the boundaries at the analytic solution.
# NB the Cartesian default is periodic, which silently destroys this problem
inner_x1 = hubble
outer_x1 = hubble
check_inflow_inner_x1 = false
check_inflow_outer_x1 = false

<coordinates>
base = cartesian_minkowski
transform = null

<parthenon/time>
tlim = 3e-05
integrator = rk2

<GRMHD>
cfl = 0.9
gamma = 1.666667
reconstruction = weno5

<debug>
verbose = 1
flag_verbose = 0
extra_checks = 1

<b_field>
solver = none

<hubble>
mach = 1.
# Optimal number to avoid relativistic effects and keep the ratio between density/internal energy
v0 = 1e-3
set_tlim = true
dyntimes = 1.

<electrons>
on = true
constant = true
gamma_e = 1.333333
# All of the dissipation goes to the electrons, i.e. f_e = 1 in Ressler+ '15
fel_constant = 1.0
# The problem sets Kel itself, from eq. 40 -- don't overwrite it with fel_0*u/rho^game.
# The ratio ue0/ug0 is not free here, it is pinned to (gam-2)/(game-2) = 0.5
init_to_fel_0 = false
limit_kel = false

<driver>
type = imex

<parthenon/output0>
file_type = hdf5
write_xdmf = false
dt = 100.0
# This is a convergence test, errors get well below single precision
single_precision_output = false
variables = prims.rho, prims.u, prims.uvec, prims.Ktot, prims.Kel_Constant, fflag
