# Bondi flow problem in 1D
# Mostly a regression test that we can still do 1D spherical

<parthenon/job>
problem_id = bondi

<parthenon/mesh>
nx1 = 128
nx2 = 1
nx3 = 1

<parthenon/meshblock>
nx1 = 128
nx2 = 1
nx3 = 1

<coordinates>
base = spherical_ks
transform = eks
a = 0.0
hslope = 0.3
r_in = 3.0
r_out = 30.0

<parthenon/time>
tlim = 50.0

<GRMHD>
cfl = 0.9
gamma = 1.666667
reconstruction = weno5

<eos>
type = IdealGas
Cv = 1.0

<bondi>
# Bondi problem parameters:
# density scaling/accretion rate
mdot = 1.0
# Sonic point
rs = 8.0

<floors>
# Disable floors
disable_floors = true
# If using B field, enable w/:
#rho_min_geom = 1e-6
#u_min_geom = 1e-8
#gamma_max = 10


<boundaries>
# We'll be adding material, and that's okay
check_inflow_outer_x1 = false

<b_field>
# No field
#solver = none
# To add magnetic field
# note only flux_ct/cell-centered B is supported in 1D!
solver = flux_ct
type = monopole_cube
B10 = 1

<debug>
verbose = 1
flag_verbose = 2
extra_checks = 1

<parthenon/output0>
file_type = hdf5
write_xdmf = false
dt = 5.0
single_precision_output = true
# Fields not present are silently ignored
variables = prims, pflag

<parthenon/output1>
file_type = hst
dt = 0.1
