# Bondi flow problem
# Model a spherically symmetric, unmagnetized inflow

<parthenon/job>
problem_id = bondi

<parthenon/mesh>
# Full mesh size, no refinement
# Don't bother with xN boundaries for spherical coordinate systems
# KHARMA will automatically place ~5 zones inside the EH
nx1 = 128
nx2 = 128
nx3 = 1

<parthenon/meshblock>
# We use more MeshBlocks than necessary, for debugging
nx1 = 32
nx2 = 32
nx3 = 1

<coordinates>
# Spherical Kerr-Schild coords
base = spherical_ks
# MKS of Gammie '03
transform = mks
# BH spin
a = 0.0
# MKS parameter
hslope = 0.3
# Radial domain in r_g
r_in = 3.0
r_out = 30.0
# If using "Funky" MKS later, where is "startx1"?
fmks_zero_point = 1.0

<parthenon/time>
tlim = 50.0

<GRMHD>
cfl = 0.9
gamma = 1.666667
reconstruction = weno5

<bondi>
# Bondi problem parameters:
# density scaling/accretion rate
mdot = 1.0
# Sonic point
rs = 8.0
# Inner radius.  This is set at EH to pass tests
r_in_bondi = 2.
# Whether to fill with high density inside r_in or leave it at floors
fill_interior = true
# Conical angle to leave clear at poles
bondi_clear_angle = 0.
# For reducing infall velocity, fraction of usual
ur_frac = 1.
# For angular momentum, proportion of Keplerian
uphi = 0.

<floors>
# Disable floors
disable_floors = true

<inverter>
# Don't hide problems by being cute about inversion
# We should never hit inversion failures in this problem
backstop = false
fix_average_neighbors = true

<boundaries>
# We'll be adding material, and that's okay
check_inflow_outer_x1 = false

<b_field>
# Disable the whole module
solver = none
# Radial monopole, still stationary
# For vertical field/non-test problems see `bondi_b_vertical.par`
#solver = face_ct
#type = monopole_cube
#B10 = 1

<debug>
verbose = 1
flag_verbose = 2
extra_checks = 1

<parthenon/output0>
file_type = hdf5
write_xdmf = false
dt = 5.0
single_precision_output = true
variables = prims, pflag

<parthenon/output1>
file_type = hst
dt = 0.1
